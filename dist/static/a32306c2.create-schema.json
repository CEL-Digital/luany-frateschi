[
  {
    "fields": [
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "message": "O título é obrigatório."
          }
        ],
        "name": "title",
        "type": "string",
        "title": "Título do Artigo"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "message": "Gere o slug a partir do título."
          }
        ],
        "name": "slug",
        "type": "slug",
        "title": "Slug (URL Amigável)"
      },
      {
        "options": {
          "list": [
            {
              "title": "Ansiedade",
              "value": "Ansiedade"
            },
            {
              "title": "Autoconhecimento",
              "value": "Autoconhecimento"
            },
            {
              "title": "Relacionamentos",
              "value": "Relacionamentos"
            },
            {
              "title": "Saúde Mental",
              "value": "Saúde Mental"
            }
          ]
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "valid",
                "constraint": [
                  "Ansiedade",
                  "Autoconhecimento",
                  "Relacionamentos",
                  "Saúde Mental"
                ]
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "name": "category",
        "type": "string",
        "title": "Categoria"
      },
      {
        "initialValue": "5 min de leitura",
        "name": "readTime",
        "type": "string",
        "title": "Tempo de Leitura (ex: 5 min de leitura)"
      },
      {
        "name": "publishedAt",
        "type": "datetime",
        "title": "Data de Publicação"
      },
      {
        "rows": 3,
        "validation": [
          {
            "level": "warning",
            "rules": [
              {
                "flag": "max",
                "constraint": 200
              }
            ],
            "message": "Mantenha o resumo curto para os cards."
          }
        ],
        "name": "excerpt",
        "type": "text",
        "title": "Resumo / Introdução"
      },
      {
        "of": [
          {
            "lists": [
              {
                "value": "bullet",
                "title": "Bulleted list"
              },
              {
                "value": "number",
                "title": "Numbered list"
              }
            ],
            "marks": {
              "annotations": [
                {
                  "i18nTitleKey": "inputs.portable-text.annotation.link",
                  "options": {
                    "modal": {
                      "type": "popover"
                    }
                  },
                  "fields": [
                    {
                      "validation": [
                        {
                          "level": "error",
                          "rules": [
                            {
                              "flag": "uri",
                              "constraint": {
                                "options": {
                                  "scheme": [
                                    "/^http$/",
                                    "/^https$/",
                                    "/^tel$/",
                                    "/^mailto$/"
                                  ],
                                  "allowRelative": true,
                                  "relativeOnly": false,
                                  "allowCredentials": false
                                }
                              }
                            }
                          ]
                        }
                      ],
                      "description": "A valid web, email, phone, or relative link.",
                      "name": "href",
                      "type": "url",
                      "title": "Link"
                    }
                  ],
                  "name": "link",
                  "type": "object"
                }
              ],
              "decorators": [
                {
                  "value": "strong",
                  "title": "Strong"
                },
                {
                  "value": "em",
                  "title": "Italic"
                },
                {
                  "value": "code",
                  "title": "Code"
                },
                {
                  "value": "underline",
                  "title": "Underline"
                },
                {
                  "value": "strike-through",
                  "title": "Strike"
                }
              ]
            },
            "of": [],
            "styles": [
              {
                "value": "normal",
                "title": "Normal"
              },
              {
                "value": "h1",
                "title": "Heading 1"
              },
              {
                "value": "h2",
                "title": "Heading 2"
              },
              {
                "value": "h3",
                "title": "Heading 3"
              },
              {
                "value": "h4",
                "title": "Heading 4"
              },
              {
                "value": "h5",
                "title": "Heading 5"
              },
              {
                "value": "h6",
                "title": "Heading 6"
              },
              {
                "value": "blockquote",
                "title": "Quote"
              }
            ],
            "type": "block"
          },
          {
            "type": "image"
          }
        ],
        "name": "content",
        "type": "array",
        "title": "Conteúdo do Artigo"
      }
    ],
    "name": "post",
    "type": "document",
    "title": "Post do Blog"
  }
]